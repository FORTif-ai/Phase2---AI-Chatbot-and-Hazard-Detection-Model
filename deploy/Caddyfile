# SITE_ADDRESS is injected from the environment.
#   - a domain (e.g. demo.example.com)  -> Caddy gets a free Let's Encrypt certificate automatically
#   - ":80"                              -> plain HTTP, for local testing (mic/voice will NOT work without HTTPS)
{$SITE_ADDRESS} {
	encode zstd gzip

	# The Node server owns the voice/text pipeline and hazard endpoints.
	@node path /api/process-text* /api/process-voice* /api/hazard-detection* /api/hazard-images*
	handle @node {
		reverse_proxy node:3001
	}

	# Everything else under /api is the RAG FastAPI service.
	handle /api/* {
		reverse_proxy rag:8000
	}

	# Static single-page app; unknown routes fall back to index.html for client-side routing.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
