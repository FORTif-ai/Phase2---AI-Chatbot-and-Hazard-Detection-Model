# Copy to a file named ".env" in the project root and fill in real values.
# The .env file is gitignored — never commit it.

# ---- Google AI Studio key (required) ----
# Used by: Weaviate (embeddings), RAG (LLM + embeddings), the voice pipeline.
GOOGLE_API_KEY=your-google-ai-studio-key

# ---- Same key, exposed under the name the hazard-detection code expects ----
GEMINI_API_KEY=your-google-ai-studio-key

# ---- RAG API auth key ----
# Sent by the dashboard as X-API-Key. Change it from the old dev default.
API_KEY=change-me-to-a-strong-random-string

# ---- Public address ----
# For automatic HTTPS: set this to your domain and point its DNS A record at the server IP.
SITE_ADDRESS=demo.yourdomain.com
# Full origin URL — used for the RAG CORS allow-list. Must match SITE_ADDRESS.
SITE_URL=https://demo.yourdomain.com

# --- Local testing without a domain (mic/voice will NOT work over plain HTTP) ---
# SITE_ADDRESS=:80
# SITE_URL=http://localhost
